{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/renderer/pages/*": ["src/pages/*"],
      "@/renderer/hooks/*": ["src/renderer/hooks/*"],
      "@/renderer/components/*": ["src/renderer/components/*"],
      "@/renderer/utils/*": ["src/renderer/utils/*"],
      "@/renderer/styles/*": ["src/renderer/styles/*"],
      "@/renderer/services/*": ["src/renderer/services/*"],
      "@renderer/pages/*": ["src/pages/*"],
      "@renderer/hooks/*": ["src/renderer/hooks/*"],
      "@renderer/components/*": ["src/renderer/components/*"],
      "@renderer/utils/*": ["src/renderer/utils/*"],
      "@renderer/styles/*": ["src/renderer/styles/*"],
      "@renderer/services/*": ["src/renderer/services/*"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "strict": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/common/types/team/database.ts"]
}
